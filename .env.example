# Copy to .env and fill in what you use. Everything here is optional; defaults are in src/formsync/config.py.

# LLM provider: gemini | groq | ollama | anthropic
LLM_PROVIDER=gemini
# Override the provider's default model id if you want (e.g. gemini-2.5-flash, llama-3.3-70b-versatile, llama3.2:3b, claude-opus-5)
# LLM_MODEL=
# Requests-per-minute pacing for free tiers
LLM_RPM=5

GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Metadata database (SQLite locally; postgresql://... in-cluster)
DATABASE_URL=sqlite:///formsync.db

# Object storage (leave S3_ENDPOINT empty for real AWS; set to http://localhost:9000 for MinIO)
S3_ENDPOINT=
S3_BUCKET=formsync

# Where run artifacts are written locally
ARTIFACT_ROOT=runs
